# Copy to .env for local real integrations. Do not commit .env.

# RD-Agent / LiteLLM provider configuration for real execution.
# OpenAI-style setup:
OPENAI_API_KEY=
OPENAI_API_BASE=
CHAT_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Azure OpenAI setup:
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=
# CHAT_MODEL=azure/<chat_deployment_name>
# EMBEDDING_MODEL=azure/<embedding_deployment_name>

# RD-Agent execution backend. Docker is recommended by RD-Agent docs.
DS_CODER_COSTEER_ENV_TYPE=docker

# Optional RD-Agent Qlib date segments.
QLIB_FACTOR_TRAIN_START=2008-01-01
QLIB_FACTOR_TRAIN_END=2014-12-31
QLIB_FACTOR_VALID_START=2015-01-01
QLIB_FACTOR_VALID_END=2016-12-31
QLIB_FACTOR_TEST_START=2017-01-01
QLIB_FACTOR_TEST_END=2020-12-31

# Optional local data and artifact locations.
QAF_ARTIFACT_DIR=artifacts
QAF_QLIB_PROVIDER_URI=data/qlib_bin/sample
